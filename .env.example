APP_NAME=StudyAI Backend
APP_ENV=development
# Public URL of the web app. It is also the base for auth email links
# (the password-reset email points at <FRONTEND_URL>/reset-password), so this
# exact origin must be listed in Supabase > Authentication > URL Configuration.
FRONTEND_URL=http://localhost:8080

# Supabase (Project Settings -> API). Leave empty here — real keys go in .env only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend (Vite) — URL of the FastAPI backend the web app calls.
# Only VITE_-prefixed variables are exposed to the browser.
VITE_API_URL=http://localhost:8000
