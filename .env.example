APP_NAME=StudyAI Backend
APP_ENV=development
# Public URL of the web app. It is also the base for auth email links
# (the password-reset email points at <FRONTEND_URL>/reset-password), so this
# exact origin must be listed in Supabase > Authentication > URL Configuration.
FRONTEND_URL=http://localhost:8080

# Supabase (Project Settings -> API). Leave empty here — real keys go in .env only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend (Vite) — URL of the FastAPI backend the web app calls.
# Only VITE_-prefixed variables are exposed to the browser.
VITE_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# MATERIAL PREVIEW — PowerPoint inline preview (optional)
# ---------------------------------------------------------------------------
# A .pptx/.ppt/.docx/.doc can't be rendered by a browser. When
# LibreOffice is installed, the backend converts it to a PDF
# locally (headless) and shows it in the existing PDF viewer.
# LibreOffice also converts a legacy .doc to .docx so its text
# can be extracted. The file never leaves this machine — no
# external conversion service is used.
#
# Install LibreOffice:
#   macOS        brew install --cask libreoffice
#   Debian/Ubuntu sudo apt-get install -y libreoffice
#   Windows      winget install TheDocumentFoundation.LibreOffice
#
# Leave empty to auto-discover LibreOffice from PATH / the usual
# install locations. Set it only if LibreOffice lives somewhere
# non-standard (e.g. a custom image).
# LIBREOFFICE_PATH=/usr/bin/soffice
# SOFFICE_PATH=
# Without LibreOffice: .pptx/.docx/.txt still preview as extracted
# text and still extract + generate notes; only the rendered-PDF
# preview and legacy .doc extraction need LibreOffice.


# ---------------------------------------------------------------------------
# RAG — embeddings (fully local; no key, no network required)
# ---------------------------------------------------------------------------
# EMBEDDING_BACKEND=hashing | sentence-transformers
#   hashing              : built-in local feature-hashing embedder (default).
#   sentence-transformers: a real local model, needs `pip install sentence-transformers`
#                          (still no API key, runs on your machine).
EMBEDDING_BACKEND=hashing
# EMBEDDING_DIM only applies to the `hashing` backend.
EMBEDDING_DIM=512
# SENTENCE_TRANSFORMERS_MODEL=all-MiniLM-L6-v2

# Chunking / retrieval tuning (optional).
RAG_CHUNK_CHARS=900
RAG_CHUNK_OVERLAP_CHARS=150
RAG_TOP_K=8
RAG_MIN_SCORE=0.05
RAG_NOTES_BATCH_CHUNKS=12

# ---------------------------------------------------------------------------
# LLM (REQUIRED for notes generation and the tutor). The backend calls an
# OpenAI-compatible /chat/completions endpoint. The key is read from
# LLM_API_KEY or, as a fallback, GEMINI_API_KEY (Google AI Studio).
# There is NO silent extractive fallback: if the key/model is missing or the
# provider fails, notes/tutor return a clear error.
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini
# Prefer GEMINI_API_KEY for Gemini. LLM_API_KEY works for any provider.
GEMINI_API_KEY=
LLM_API_KEY=
# Which Gemini (or other) model the backend calls. Change this to switch models
# without touching any code — any model your API key can use against the
# OpenAI-compatible endpoint above works. Prefer a generally-available model:
# "-preview" models share a small free-tier quota and are often "high demand".
# gemini-flash-lite-latest and gemini-2.5-flash are verified working here.
LLM_MODEL=gemini-flash-lite-latest
# Optional comma-separated backup models, tried in order when the primary model
# is rate-limited, out of quota, or overloaded, so one busy model cannot block
# the app. Keep these distinct from LLM_MODEL.
LLM_FALLBACK_MODELS=gemini-2.5-flash,gemini-flash-latest
# Base URL is derived from LLM_PROVIDER when left empty:
#   gemini     https://generativelanguage.googleapis.com/v1beta/openai
#   openai     https://api.openai.com/v1
#   openrouter https://openrouter.ai/api/v1
#   groq       https://api.groq.com/openai/v1
#   ollama     http://localhost:11434/v1
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=120
# Notes are generated in batches that now run in parallel (default 4 at a time),
# sharing one keep-alive connection pool to the provider. Raise LLM_MAX_CONCURRENCY
# for speed if your provider allows it; lower it if you hit rate limits (HTTP 429).
LLM_MAX_CONCURRENCY=4
LLM_MAX_CONNECTIONS=16
# Retry policy for provider hiccups (HTTP 408/429/5xx, timeouts): each model is
# retried LLM_MAX_ATTEMPTS times with exponential backoff plus random jitter,
# honouring the provider's Retry-After header (capped at
# LLM_RETRY_MAX_BACKOFF_SECONDS) before falling back to the next model in
# LLM_FALLBACK_MODELS. Authentication errors (401/403) and invalid requests are
# never retried. A 429 whose retry hint is longer than LLM_RETRY_MAX_BACKOFF_SECONDS
# is treated as an exhausted quota: the same model is not retried but the next
# model is, and if all are exhausted the API says so instead of "temporarily busy"
# ("The AI service is temporarily busy. Please try again shortly.").
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BACKOFF_SECONDS=0.8
LLM_RETRY_MAX_BACKOFF_SECONDS=10
# Which engine notes generation uses. Only "llm" is supported.
NOTES_GENERATION_PROVIDER=llm
